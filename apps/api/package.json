{
  "name": "@plusone/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed-cli.ts",
    "ai:try": "tsx --env-file=../../.env src/ai/try-cli.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "worker": "node --env-file-if-exists=../../.env --import tsx src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.6",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@plusone/shared": "workspace:*",
    "@renderinc/sdk": "1.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "livekit-server-sdk": "2.19.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "ag-studio": "3.0.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
