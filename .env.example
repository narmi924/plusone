# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored. Never commit real keys.

# --- Server ---
PORT=3000
# Public HTTPS address of the API (cloudflared tunnel in dev, Render URL in prod).
# Used for PayPal webhooks. Leave empty until there is one.
PUBLIC_URL=
# Password for the seller console (single seller for now).
SELLER_PASSWORD=change-me

# --- Database (docker compose default) ---
DATABASE_URL=postgres://plusone:plusone@localhost:5432/plusone

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- PayPal (US sandbox business account; REST API app credentials) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. On boot the API finds or creates this app's webhook for PUBLIC_URL;
# set this only to pin a specific webhook id.
PAYPAL_WEBHOOK_ID=

# --- LiveKit (host video -> viewers) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (host speech -> text) ---
DEEPGRAM_API_KEY=

# --- Render Workflows (background tasks) ---
# Leave empty locally: tasks then run inside the API process. On Render, set an
# API key; the Blueprint fills in the workflow's slug.
RENDER_API_KEY=
WORKFLOW_SLUG=

# --- PayPal sandbox buyer (personal test account) ---
# Used only by local end-to-end scripts that click through PayPal checkout.
# Never read by the server and never sent to the browser.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
